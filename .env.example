# Server
PORT=8787
NODE_ENV=development

# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
# The server refuses to boot in production if this is unset.
JWT_SECRET=dev-only-insecure-secret-change-me

# SQLite database location
DATABASE_PATH=./data/unlockphone.db

# Payment provider: "mock" (local, no network) or "stripe"
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Unlock supplier. "mock" simulates a DHRU-style wholesale API locally.
# "dhru" talks to a real DHRU Fusion endpoint.
SUPPLIER_PROVIDER=mock
DHRU_API_URL=
DHRU_USERNAME=
DHRU_API_KEY=

# How often the fulfilment worker polls pending orders, in milliseconds
WORKER_INTERVAL_MS=5000

# Refuse unlock orders for blacklisted / lost-stolen devices up front.
PRECHECK_DEVICES=true

# Where uploaded proof-of-ownership files are stored, and the per-file cap.
UPLOADS_DIR=./data/uploads
MAX_PROOF_BYTES=8388608

# Email delivery: "console" logs to stdout, "smtp" sends real mail
MAIL_TRANSPORT=console
MAIL_FROM="Unlock Support <support@example.com>"
